{
  "title": "Day 23 Kafka Lag And Broker Health",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Consumer Lag By Group And Topic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag_sum",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer Lag By Partition",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} / {{topic}} / p{{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Under Replicated Partitions",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "kafka_server_replicamanager_underreplicatedpartitions",
          "legendFormat": "URP",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Offline Partitions",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "kafka_controller_kafkacontroller_offlinepartitionscount",
          "legendFormat": "offline",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log Size By Topic Partition",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "kafka_log_log_size",
          "legendFormat": "{{topic}} / p{{partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}
